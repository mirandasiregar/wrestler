rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for tournaments and its subcollections
    match /tournaments/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for matches (supporting collectionGroup)
    match /{path=**}/matches/{matchId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for athletes
    match /athletes/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for matches (top-level fallback if used)
    match /matches/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
